	)) (text "PREAMPLIFICATORE DI CARICA (OPA4172 A, Cf 1 pF + Rf 100M di default) -> shaper CR-RC tau 1 us: C invertente x10 (CR), D non invertente x5 (RC) = x50. Base 1V25 bufferizzata da B." (exclude_from_sim no) (at 25.40 15.24 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6cc8cf1e-8901-44ab-a0ca-8416ed677dd7")) (text "BPW34 a 30-36 V: Cd ~8-9 pF, MIP ~1-1.3 fC -> ~1 mV su CSA_OUT (negativo), ~50 mV positivi su SHAPER_OUT sopra 1.25 V. Filtro ADC 47R + 1 nF." (exclude_from_sim no) (at 25.40 20.32 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b96a0d99-212e-4132-9560-a3848b472e5c")) (text "OPZIONE JFET (DNP): BF862 a source comune + BF862 cascode. Diretto = R120/R121 montate; JFET = togliere R120/R121, montare R122/R123, Q101/Q102 e la polarizzazione (valori da tarare)." (exclude_from_sim no) (at 25.40 25.40 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "023e0486-7f19-4f2a-8db5-59db35717b7a")) (wire (pts (xy 50.80 40.64) (xy 45.72 40.64)) (stroke (width 0) (type default)) (uuid "95681ea6-de7c-4467-8363-2afb961b8c67")) (label "OPA_POS" (at 45.72 40.64 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "7c4854df-5eda-40c5-b20d-550595c44f43")) (wire (pts (xy 50.80 43.18) (xy 45.72 43.18)) (stroke (width 0) (type default)) (uuid "60c96b55-4752-4871-b034-08913a3b4fa3")) (label "OPA_NEG" (at 45.72 43.18 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "708fd808-f9bb-4f7a-86af-d2c45afd4209")) (wire (pts (xy 50.80 45.72) (xy 45.72 45.72)) (stroke (width 0) (type default)) (uuid "836d4428-e5ea-4284-b73a-afc1aa9a6ec9")) (global_label "1V25_REF" (shape passive) (at 45.72 45.72 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "b5fb6846-166a-44ee-9e7e-4ea74bd2471a")) (wire (pts (xy 50.80 48.26) (xy 45.72 48.26)) (stroke (width 0) (type default)) (uuid "5c5b31ba-f6e8-4ab1-bf2e-c40f4ce62f2b")) (label "SH_BASE" (at 45.72 48.26 180) (effects (font (size 1
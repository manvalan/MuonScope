	)) (text "RETROAZIONE: R201 100M sempre presente (DC definita anche con MCP in reset). Rf 10k..10M con TMUX1112 (chiuso con SEL=1, pull-down 100k = aperti al reset)." (exclude_from_sim no) (at 25.40 15.24 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a5abfc0e-067d-465a-90a5-b959763d49c2")) (text "Cf: C201 1 pF fisso (default) + banchi BGSA142: -IN -> Cf -> RFx -> RFC -> 10 nF C0G -> uscita. 100M verso GND su ogni RFx e RFC. CTL tramite partitore 10k/22k (3.3 V -> 2.27 V, pull-down al reset)." (exclude_from_sim no) (at 25.40 20.32 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e4d1d504-d7ff-4645-bbeb-f213a37e7be0")) (wire (pts (xy 50.80 40.64) (xy 45.72 40.64)) (stroke (width 0) (type default)) (uuid "2d4954a7-165e-44aa-ad82-efed199a7509")) (global_label "+3V3" (shape passive) (at 45.72 40.64 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "4a49a951-fe43-4d3e-b7fe-510ca0131670")) (wire (pts (xy 50.80 43.18) (xy 45.72 43.18)) (stroke (width 0) (type default)) (uuid "5c05aa02-a8f3-4955-b65c-b95b891fb3fc")) (global_label "GND" (shape passive) (at 45.72 43.18 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "1008df12-b499-426d-97a6-d0cbebcdd1d4")) (wire (pts (xy 50.80 45.72) (xy 45.72 45.72)) (stroke (width 0) (type default)) (uuid "637036b2-e7fa-4479-959a-15889d8d1dc5")) (global_label "GND" (shape passive) (at 45.72 45.72 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "e661e23b-ba97-45b1-a5ed-9ccc550d36f1")) (wire (pts (xy 50.80 48.26) (xy 45.72 48.26)) (stroke (width 0) (type default)) (uuid "3a212fb2-08fd-41ee-b915-5950d19a3942")) (global_label "CS_MCP" (shape passive) (at 45.72 48.26 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "41fec98e-5405-4290-9ace-e9fb906229d8")) (wire (pts (xy 50.80 50.80) (xy 45.72 50.80)) (stroke (width 0) (type default)) (uuid "721f000c-c0d2-4553-ba0b-27
	)) (text "U5 W25Q128JV 16 MB su QSPI1 porta A, SS0: boot. U40 W25N04KV 512 MB SPI NAND SLC su SS1 (NAND_DATA07): rootfs UBIFS. Bus QSPI in comune. Il ROM del 6ULL non avvia da SPI NAND: per questo restano due chip." (exclude_from_sim no) (at 20.00 17.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c11776d8-4b6c-43ba-b1c7-42c156e04982")) (text "J5 microSD DM3AT su uSDHC1 (sul BOTTOM), 3.3 V, CD su UART1_RTS_B (USDHC1_CD_B). U25 protegge DAT0-3: CMD e CLK non hanno ESD (un solo TPD4E in BOM, 4 linee)." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "127dcccb-8b67-4e66-8bae-01f27751c2d8")) (wire (pts (xy 54.61 53.34) (xy 49.53 53.34)) (stroke (width 0) (type default)) (uuid "f494c0fb-f3ef-4f27-8527-3801a8759961")) (hierarchical_label "QSPI_CS_N" (shape passive) (at 49.53 53.34 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "4b4fe68a-3c46-4819-b7de-d234acb8473e")) (wire (pts (xy 54.61 60.96) (xy 49.53 60.96)) (stroke (width 0) (type default)) (uuid "a113b21a-54f9-4cc2-9eec-6648538b4fe6")) (hierarchical_label "QSPI_D1" (shape passive) (at 49.53 60.96 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "24010018-b414-4601-af3b-3f7b6daeaf1d")) (wire (pts (xy 54.61 63.50) (xy 49.53 63.50)) (stroke (width 0) (type default)) (uuid "c18e58eb-6fff-4771-b63e-adb07f9415bd")) (hierarchical_label "QSPI_D2" (shape passive) (at 49.53 63.50 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "6df77dda-b1ab-4f5d-ab1f-6b4e2e4f273a")) (wire (pts (xy 64.77 73.66) (xy 64.77 78.74)) (stroke (width 0) (type default)) (uuid "e639473a-9ead-435a-93c4-3018e1dc1669")) (global_label "GND_D" (shape passive) (at 64.77 78.74 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "90e21a95-0454-4fdd-be8c-ed4f3ca31755")) (wire (pts (xy 54.61 58.42) (xy 49.53 58.42)) (stroke (width 0) (type default)) (uuid "b3f1dd26-5995-4357-a29e-87a0925af036")) (hierarchical_label
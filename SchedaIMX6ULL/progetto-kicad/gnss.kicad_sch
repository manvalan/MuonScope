	)) (text "U11 u-blox NEO-M9N-00B su UART3. TIMEPULSE -> 33R -> GNSS_PPS su GPT1_CAPTURE1 (UART2_TX) e buffer U20 -> 33R -> header J7. EXTINT IN da J7 -> ESD + 100R -> buffer U19 -> GNSS_EXTINT su NEO e GPT1_CAPTURE2 (UART2_RX): evento marcato da entrambi." (exclude_from_sim no) (at 20.00 17.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f00bcc58-4c1d-4399-8bf1-b4ce83370bd2")) (text "J4 SMA antenna, bias 3.3 V attiva: VCC_RF -> 10R -> 27 nH (0603) -> RF_IN, 10 nF. Linea 50 ohm corta. V_BCKP da VDD_SNVS (CR1220 via BAT54C). J7: PPS OUT, EXTINT IN, GND (come scheda Tibbo)." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a078de0b-da56-464a-bc51-b48e98bf1eb0")) (wire (pts (xy 54.61 83.82) (xy 49.53 83.82)) (stroke (width 0) (type default)) (uuid "63c211c3-933b-474e-b65a-4d42d43de262")) (label "GNSS_SAFEBOOT_N" (at 49.53 83.82 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "3fb7c39b-32fe-4d2f-8dd5-70723b9b701f")) (no_connect (at 54.61 88.90) (uuid "6ad6ebf0-1c1d-4a1a-bfbc-90335bbc7be2")) (wire (pts (xy 90.17 78.74) (xy 95.25 78.74)) (stroke (width 0) (type default)) (uuid "509cb554-4206-4f26-add7-ff21762e7bdc")) (label "GNSS_TP" (at 95.25 78.74 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1f90553e-a7bd-4873-8e0d-77baf0b825c8")) (wire (pts (xy 54.61 78.74) (xy 49.53 78.74)) (stroke (width 0) (type default)) (uuid "485a3a32-25cb-4d1a-9add-20bac54cdc2d")) (global_label "GNSS_EXTINT" (shape passive) (at 49.53 78.74 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "104d8a03-42d5-4492-9198-a0adb9a6b061")) (no_connect (at 54.61 55.88) (uuid "ac37285c-7fa6-40dc-a94e-17199e0b9e5a")) (no_connect (at 54.61 58.42) (uuid "ebdede5c-821b-4a5c-b593-8c54f0772888")) (wire (pts (xy 72.39 48.26) (xy 72.39 43.18)) (stroke (width 0) (type default)) (uuid "d7cd4d22-3807-401b-972a-7bf645a7c337")) (global_label "GND_D" (shape passive) (at 72
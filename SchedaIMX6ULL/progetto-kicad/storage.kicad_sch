	)) (text "U5 W25Q128JV su QSPI1 porta A (tabella 79, boot). J5 microSD DM3AT su uSDHC1 (sul BOTTOM), 3.3 V, CD su UART1_RTS_B (USDHC1_CD_B). U25 protegge DAT0-3: CMD e CLK non hanno ESD (un solo TPD4E in BOM, 4 linee)." (exclude_from_sim no) (at 20.00 17.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "44e29a95-6801-4b69-9379-fc34c3c77511")) (text "U38 JMS578 (QFN-48 6x6 passo 0.4): solo USB 2.0, SuperSpeed non collegati. Datasheet Rev 1.01: 12K su REXT, 10 nF serie su SATA, 4.7 uH su LXO -> 1.2 V (VCCK/AVDDL), 30 MHz, MODE[1:0]=01, TME=0. VREG_IN e VBUS da 5V_SYS, VCCO dal suo AV33O." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8ac8679a-fd1f-4e02-8055-e6c037c73a5c")) (text "Niente SPI NVRAM del JMS578 (facoltativa, solo VID/PID vendor e firmware aggiornabile): usa il ROM interno. J13 solo SSD SATA: DEVSLP basso, PEDET libero. Nessun reference JMicron pubblico: da confermare sul primo prototipo." (exclude_from_sim no) (at 20.00 27.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0aeb9bae-9371-464f-868a-b9b014e52dc3")) (wire (pts (xy 54.61 58.42) (xy 49.53 58.42)) (stroke (width 0) (type default)) (uuid "cce316e5-f1e3-418d-8169-372f646fa625")) (hierarchical_label "QSPI_CS_N" (shape passive) (at 49.53 58.42 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "72ae307b-cfdd-431c-a4b3-27bd967c29b5")) (wire (pts (xy 54.61 66.04) (xy 49.53 66.04)) (stroke (width 0) (type default)) (uuid "d1c481af-8018-4a21-8852-ed4da1290716")) (hierarchical_label "QSPI_D1" (shape passive) (at 49.53 66.04 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "f7ff0a59-1673-48bc-8b34-43ce64ae50e9")) (wire (pts (xy 54.61 68.58) (xy 49.53 68.58)) (stroke (width 0) (type default)) (uuid "af453218-0229-4243-8931-ea1ad879b0f0")) (hierarchical_label "QSPI_D2" (shape passive) (at 49.53 68.58 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "10137734-0f7c-49cf-b56f-22a7e1
	)) (text "J11 BUS_POWER 30 pin (Hirose FH12-30S) su ECSPI2, J12 MAIN 28 pin REV5.1 (XUNPU FPC-05F-28PH20, pin 28 = HIT#) su ECSPI1. Mappa dei connettori identica a SchedaA133/RK3568. Rail BUS_* passanti, non collegati ai rail della scheda." (exclude_from_sim no) (at 20.00 17.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a2de1767-8c75-42c9-a3ff-6afe4fc8fb7d")) (text "Serie 33R su CLK/MOSI/MISO, 100R su ADDR/PREFIX, pull-up 10k sui CS, 4.7k su ALERT#/HIT#, 2.2k su I2C. VREF_ENABLE 10k e VBIAS_ENABLE 100k a GND. ESD TPD4E05U06DQA sulle linee logiche." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a9d367e1-ca7b-4ef3-ba55-b0d7aefb2049")) (wire (pts (xy 54.61 53.34) (xy 49.53 53.34)) (stroke (width 0) (type default)) (uuid "72f3ae27-83d5-43a4-901c-57164de628e4")) (label "GND_A" (at 49.53 53.34 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "81920f67-d908-47ed-a70b-4991d71bb468")) (wire (pts (xy 54.61 55.88) (xy 49.53 55.88)) (stroke (width 0) (type default)) (uuid "b5d76256-0316-4bd6-9ec4-a8b665337c09")) (label "BUS_VBIAS_1" (at 49.53 55.88 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "a9e0ce4e-b54c-4e80-9a67-9d9dc2163c98")) (wire (pts (xy 54.61 58.42) (xy 49.53 58.42)) (stroke (width 0) (type default)) (uuid "d1500e7e-2bc6-40f1-8f36-5c6b11e1b3c5")) (label "BUS_VBIAS_2" (at 49.53 58.42 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "03164bc1-0760-4d0f-be5b-d0a1a89809eb")) (wire (pts (xy 54.61 60.96) (xy 49.53 60.96)) (stroke (width 0) (type default)) (uuid "f72996a6-493d-442a-9d42-aed61441e1d7")) (label "GND_A" (at 49.53 60.96 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "7f1bf620-b393-48c8-9742-15d2d021e15a")) (wire (pts (xy 54.61 63.50) (xy 49.53 63.50)) (stroke (width 0) (type default)) (uuid "43e20a42-de7c-4a09-b79b-361c07786462")) (label "BUS_2V5_REF" (at 49.53 63.50 180) (effects (font (size 1.27 1.
	)) (text "U35 LB-LINK BL-M8723DS1 (RTL8723DS, 12x12 mm, datasheet V1.0.1.3): Wi-Fi su uSDHC2 (pad NAND), BT su UART8 (pad ENET2). VDD33 e VDIO da U37 (3.3 V dedicati ai picchi TX). WL_DIS# e BT_DIS# senza pull-up nel modulo: 10k a GND, li alza Linux." (exclude_from_sim no) (at 20.00 17.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d4d51dec-b300-4055-b66b-93a9c8b08050")) (text "SDIO con i pull-up interni del 6ULL. Antenna su U.FL J14 (scelta del placement: la BOM lasciava u.FL o PCB) con rete pi 0R + 2 DNP da tarare. UART_CTS del modulo da UART8_RTS, il modulo non ha RTS (pin 41 = GND): H5 a 3 fili. PCM non usata: PCM_OUT libero (strap da non alzare)." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6d254de2-55c0-4eb2-929c-7cdc25e34905")) (wire (pts (xy 54.61 48.26) (xy 49.53 48.26)) (stroke (width 0) (type default)) (uuid "3c8d251b-7797-426f-bba3-3eb9a5d77af5")) (global_label "GND_D" (shape passive) (at 49.53 48.26 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "71cec3b4-9e76-4fcb-8933-b05945996676")) (wire (pts (xy 54.61 50.80) (xy 49.53 50.80)) (stroke (width 0) (type default)) (uuid "0c743a25-3a52-4922-919a-05ea08501266")) (label "WL_ANT" (at 49.53 50.80 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "688ffe7c-cc6e-4f94-bde3-be11b81aa6bd")) (wire (pts (xy 54.61 53.34) (xy 49.53 53.34)) (stroke (width 0) (type default)) (uuid "41288559-8d40-4471-b4fd-3dd3c0ddffc2")) (global_label "GND_D" (shape passive) (at 49.53 53.34 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "e46984f7-8910-4421-a63f-f605c3927c72")) (no_connect (at 54.61 55.88) (uuid "9f47ab50-c607-4c0f-b130-8bc661025bfe")) (no_connect (at 54.61 58.42) (uuid "ae4cc2eb-5ee6-4450-b4ad-ef18d90c0d9a")) (wire (pts (xy 54.61 60.96) (xy 49.53 60.96)) (stroke (width 0) (type default)) (uuid "ebbb7f2f-b639-4b4d-9ba2-a6e30719b52b")) (global_lab
		(embedded_fonts no)
	)) (text "J3 USB-C 1: USB_OTG1, device/download seriale e alimentazione (VBUS1 -> IN2 del TPS2121). Sink: 5.1k su CC1/CC2. J8 USB-C 2 host: porta 1 dell'hub, VBUS dal TPS2553 (~1 A), Rp 56k. Le due USB-C sono affiancate sullo stesso bordo." (exclude_from_sim no) (at 20.00 17.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "45be1dbd-19a1-4380-9b6a-0a7317c6214c")) (text "U36 FE1.1s Rev B su USB_OTG2 (3.3 V esterni su VD33F, VDD5 e pin 12/13/28 liberi come da datasheet Rev B12.4): porta 1 J8, porta 2 JMS578, porte 3-4 libere. VBUSM e BUSJ a 3.3 V (host sempre presente, self-powered). USB_OTG2_VBUS del 6ULL da 5V_SYS." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6745a926-b304-46b9-a283-09e4a3786a7a")) (wire (pts (xy 54.61 48.26) (xy 49.53 48.26)) (stroke (width 0) (type default)) (uuid "b45df90c-272c-4a12-9131-03eda9411f62")) (global_label "GND_D" (shape passive) (at 49.53 48.26 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "4fdf882c-961e-445e-85c0-8f58e6cb08b8")) (wire (pts (xy 54.61 50.80) (xy 49.53 50.80)) (stroke (width 0) (type default)) (uuid "6bc7ba7c-7237-48be-b80d-9cb7d08571ae")) (global_label "VBUS1" (shape passive) (at 49.53 50.80 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "29e47d66-f5ab-4cf9-acab-e11119b3f08b")) (no_connect (at 54.61 53.34) (uuid "12cf3fab-c8b6-49fe-91cd-9a242763a0f4")) (wire (pts (xy 54.61 55.88) (xy 49.53 55.88)) (stroke (width 0) (type default)) (uuid "242b8aed-8217-4f9a-baad-cf49d441fbe6")) (label "USB1_CC1" (at 49.53 55.88 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "ee33f1f8-a508-4dc7-b272-bfb2bd7b6262")) (wire (pts (xy 54.61 58.42) (xy 49.53 58.42)) (stroke (width 0) (type default)) (uuid "0cbb9330-ae1b-4ab2-9442-047304401eb0")) (global_label "USB1_DM" (shape passive) (at 49.53 58.42 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justif
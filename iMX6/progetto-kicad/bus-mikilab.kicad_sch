	)) (text "J BUS_POWER 30 pin (Hirose FH12-30S) su ECSPI4 (pad ENET2, ex touch), J MAIN 28 pin REV5.1 (XUNPU FPC-05F-28PH20) su ECSPI1 (pad CSI_DATA04-07, ex espansione P1). Mappa dei connettori come SchedaIMX6ULL-SD." (exclude_from_sim no) (at 20.00 17.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e6a50859-f788-4521-820d-c35aefd769f1")) (text "Serie 33R sui clock SPI. Pull-up 4.7k su ALERT#/HIT#, 2.2k su I2C. VREF_ENABLE 10k e VBIAS_ENABLE 100k a GND. CS e FAULT con i pull-up interni del 6ULL. ESD TPD4E05U06DQA sulle linee logiche." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "451e1cc0-7a44-4739-8bbb-42cec5864812")) (wire (pts (xy 54.61 53.34) (xy 49.53 53.34)) (stroke (width 0) (type default)) (uuid "a9ebb526-774c-4214-8cdf-28d513d2f3f9")) (label "GND_A" (at 49.53 53.34 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "e6091aea-0b4d-446d-9680-378c800b7812")) (wire (pts (xy 54.61 55.88) (xy 49.53 55.88)) (stroke (width 0) (type default)) (uuid "74e014aa-3bdb-4adc-8169-7148e34d4873")) (label "BUS_VBIAS_1" (at 49.53 55.88 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "cc860dcc-cedd-4bc3-8fb6-147816c3bffb")) (wire (pts (xy 54.61 58.42) (xy 49.53 58.42)) (stroke (width 0) (type default)) (uuid "f8ed1448-7688-4b53-87f3-36be225aef70")) (label "BUS_VBIAS_2" (at 49.53 58.42 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "7f9759ff-8eb8-4aa2-834d-7c8c77a41b0c")) (wire (pts (xy 54.61 60.96) (xy 49.53 60.96)) (stroke (width 0) (type default)) (uuid "e8d01948-1c08-467f-a47f-368414e75e85")) (label "GND_A" (at 49.53 60.96 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "0d81a053-5169-4b70-a8a0-07ca41ac2e10")) (wire (pts (xy 54.61 63.50) (xy 49.53 63.50)) (stroke (width 0) (type default)) (uuid "6f724066-5373-49dd-9eec-750c320983ad")) (label "BUS_2V5_REF" (at 49.53 63.50 180) (effects (font (size 1.27 1.27)) (justify ri
273bc53c")) (pin "AH14" (uuid "f73d201c-c2eb-4932-9d39-0833054a87ef")) (pin "AG13" (uuid "3c7f70ea-8599-4f34-8851-638c63e8475e")) (pin "AH13" (uuid "4862a420-1c67-46a1-9532-216c26320143")) (pin "AE15" (uuid "a8600531-0d5f-4c58-8d63-4455e9f37838")) (pin "AD15" (uuid "f8c55b56-0fd5-43f8-9522-b02a559445f9")) (pin "AE18" (uuid "44b6b6c4-3573-49c0-83ff-b36723088691")) (pin "AD18" (uuid "08d9a060-10e6-44ff-a5e5-a24139a509e1")) (pin "AC17" (uuid "05744152-a2ca-4f60-9bb8-a0e6088ed3f2")) (pin "AD17" (uuid "16a60df9-6734-4187-9187-d80b12634002")) (pin "AC14" (uuid "3ca2de36-3d8b-454f-a608-f9837396bead")) (pin "AD14" (uuid "77ca43ec-3694-44a5-b9da-aefac550f6a9")) (pin "AE12" (uuid "40553447-d631-44a3-88f2-bbb8c0f45017")) (pin "AD12" (uuid "b5a52dba-0ff6-4aea-b651-eadea0487996")) (instances (project "SchedaRK3568" (path "/ca22b936-6f4a-45ef-aa0b-04959bbbf7ee/e7d21977-abf1-4d76-a93a-c58d67749175" (reference "U301") (unit 9))))) (text "CPU: Rockchip RK3568 (FCBGA636L 19x19 mm, passo 0.65 mm, LCSC C2938930). Ball map: Rockchip RK3568 PinOut V1.1, verificata sulla tabella 2-1 del datasheet V1.2 (636/636). Serie 3xx." (exclude_from_sim no) (at 20.00 20.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0a527bc3-e592-4196-8ea5-91eb9cee0bfd")) (text "Domini IO: PMUIO1/PMUIO2 = VCC3V3_PMU (3.3 V), VCCIO2 = VCC1V8_EMMC (1.8 V, FLASH_VOL_SEL alto), VCCIO3 = VCCIO_SD, VCCIO4-7 = VCC_3V3 (3.3 V), VCCIO1 non usato (flottante, come da Rockchip)." (exclude_from_sim no) (at 20.00 26.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "104a6b7e-4557-4f57-aa9a-9a73b4a7ab28")) (text "PHY non usati (USB2 HOST2/3, MULTI_PHY, PCIe3, MIPI CSI/DSI, HDMI, eDP): alimentazioni a VSS e segnali flottanti, secondo 'RK3568 Processing instructions for unused pins'. VDD_NPU su BUCK4 dell'RK809-5." (exclude_from_sim no) (at 20.00 32.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4a40dfe2-e127-4c40-a63f-b156b219784c")) (text "DDR4 a 16 bit sul canale A del PHY (DQ0-15_A, nomi DDR4_DQL/DQU_A del pinout Rockchip); canale B, ECC, CS1n, ODT1, BG1 non usati. Mappa completa in docs/pinmap-rk3568.md." (exclude_from_sim no) (at 20.00 38.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "558d5128-ee3a-487e-9887-15ad863524f7")) (text "24 MHz (Hardware Design Guide RK3568 fig. 2-1 / reference AIoT): 22R serie su XOUT24M, 1M tra XIN e XOUT, 18 pF per lato (da adattare al CL del quarzo, tolleranza 20 ppm)." (exclude_from_sim no) (at 840.00 48.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "48dc63b7-3810-4524-802a-59510d548428")) (wire (pts (xy 861.06 63.50) (xy 858.52 63.50)) (stroke (width 0) (type default)) (uuid "338e97c1-ad68-4457-abd3-e91c81c99952")) (label "XTAL24_X1" (at 858.52 63.50 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "3aa0b578-7207-4396-a2c8-56d6375113b6")) (wire (pts (xy 864.87 68.58) (xy 864.87 71.12)) (stroke (width 0) (type default)) (uuid "099a68a6-9da4-4d25-8a01-c3f19898a3e4")) (global_label "GND_D" (shape passive) (at 864.87 71.12 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "fcfaa408-043f-4da4-9d48-c5b2fea90baa")) (wire (pts (xy 868.68 63.50) (xy 871.22 63.50)) (stroke (width 0) (type default)) (uuid "6720e7cd-37d3-46ce-9ac7-a34d84860c43")) (label "XIN24M" (at 871.22 63.50 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ca33f1e9-6677-43e4-b5ed-0115511bd630")) (symbol (lib_id "Device:Crystal_GND24") (at 864.87 63.50 0) (unit 1) (body_style 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (dnp no) (uuid "ecd402f2-8dc8-4ead-91fe-713ed6a2760e") (property "Reference" "Y301" (at 867.41 62.23 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "24MHz" (at 867.41 64.77 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Crystal:Crystal_SMD_3225-4Pin_3.2x2.5mm" (at 864.87 63.50 0) (hide yes) (effects (font (size 1.27 1.27)))) (prop
	)) (text "USB HOST: USB1 del SoC su USB-C (16 pin, HRO TYPE-C-31-M-12), solo host, come SchedaA133. Serie 8xx. Net USB1_* globali verso il foglio CPU." (exclude_from_sim no) (at 20.00 15.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a58bdf9a-e3b3-49d3-889d-3842540656b1")) (text "La porta non alimenta mai la scheda: VBUS esce solo dal load switch. Rp fissi da 22k a 5V_SYS su CC1/CC2 = sorgente 1.5 A (Type-C), niente controller PD." (exclude_from_sim no) (at 20.00 20.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "9b811a58-defb-4d3f-99ee-f5fab5ab361a")) (text "TPS2553: EN attivo alto dall'espansore (P03) con 100k a GND, FAULT open-drain su PC12 (pull-up 10k a VCC-1V8 sul foglio CPU)." (exclude_from_sim no) (at 20.00 48.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "14dbf978-f221-4f09-a10d-668a83c03a82")) (text "RILIM 26.1k 1% = 0.91 / 0.99 / 1.08 A (min/nom/max, tabella 2 del datasheet)." (exclude_from_sim no) (at 20.00 53.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "57f1e342-13be-428d-b7c9-2e9a7ecb4624")) (wire (pts (xy 30.48 66.04) (xy 30.48 63.50)) (stroke (width 0) (type default)) (uuid "5e474cc7-a660-4986-94dd-740ca1461b9f")) (hierarchical_label "5V_SYS" (shape passive) (at 30.48 63.50 90) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6ccce620-33b2-4b01-80ec-aeaf5669b88b")) (wire (pts (xy 30.48 73.66) (xy 30.48 76.20)) (stroke (width 0) (type default)) (uuid "92b795e7-a6fb-4727-925c-94cb32b216ce")) (global_label "GND_D" (shape passive) (at 30.48 76.20 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "f2b3235e-6295-4ccf-8ba2-d96529731ef9")) (symbol (lib_id "Device:C") (at 30.48 69.85 0) (unit 1) (body_style 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (dnp no) (uuid "0c4d6b3c-425a-4af2-b93a-2235a8932d66") (property "Reference" "C801" (at 33.02 68.58 0) (effects (font (size 1.27 1.27)) (justify left))) (
	)) (text "USB HOST: USB3_HOST1_DP/DM dell'RK3568 (parte USB 2.0, alimentata da USB3_AVDD) su USB-C (16 pin, HRO TYPE-C-31-M-12), solo host. Serie 8xx. Net USB1_* globali." (exclude_from_sim no) (at 20.00 15.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f1328d1b-a82a-4d9e-b3f2-5f78d674ea64")) (text "La porta non alimenta mai la scheda: VBUS esce solo dal load switch. Rp fissi da 22k a 5V_SYS su CC1/CC2 = sorgente 1.5 A (Type-C), niente controller PD." (exclude_from_sim no) (at 20.00 20.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3aa1e7d6-02a9-4b2c-b173-1a0df6110851")) (text "TPS2553: EN attivo alto da GPIO0_A6 con 100k a GND, FAULT open-drain su GPIO0_B6 (pull-up 10k a VCC3V3_PMU sul foglio CPU)." (exclude_from_sim no) (at 20.00 48.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "10b7aced-d9f2-457b-ac43-95a6fac62968")) (text "RILIM 26.1k 1% = 0.91 / 0.99 / 1.08 A (min/nom/max, tabella 2 del datasheet)." (exclude_from_sim no) (at 20.00 53.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "50634118-a738-4ed6-9d07-3275f349c0ec")) (wire (pts (xy 30.48 66.04) (xy 30.48 63.50)) (stroke (width 0) (type default)) (uuid "cc354dc1-ceea-413b-a15a-0002ffd47d17")) (hierarchical_label "5V_SYS" (shape passive) (at 30.48 63.50 90) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1f63687d-5f54-4396-bf36-668d33e680c3")) (wire (pts (xy 30.48 73.66) (xy 30.48 76.20)) (stroke (width 0) (type default)) (uuid "da6218b8-7b7b-4850-9c5b-20a6d031f88d")) (global_label "GND_D" (shape passive) (at 30.48 76.20 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "ab3dcf4b-02e9-4735-bfc3-10efe1dedaa5")) (symbol (lib_id "Device:C") (at 30.48 69.85 0) (unit 1) (body_style 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (in_pos_files yes) (dnp no) (uuid "f5fdab76-14eb-4b5c-9f01-71bf993d644b") (property "Reference" "C801" (at 33.02 68.58 0) (effects (font (size 1.27 1.27)) 
perty "Footprint" "Capacitor_SMD:C_1206_3216Metric" (at 248.92 69.85 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 248.92 69.85 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "" (at 248.92 69.85 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "c9634507-e6c0-44cf-b39a-e1f51b0d62f6")) (pin "2" (uuid "c12935ef-70b1-49fb-8f5a-1df58c0216cc")) (instances (project "SchedaRK3568" (path "/ca22b936-6f4a-45ef-aa0b-04959bbbf7ee/368a7955-35cb-43c9-baa5-56ecec05a320" (reference "C128") (unit 1))))) (text "TPS56637 (tabella 4 del datasheet, Vout 5 V): Vfb 0.6 V, R103/R104 73.2k/10k = 4.99 V, L 3.3 uH, Cout 4x22 uF, feed-forward R116 20k + C126 100 pF." (exclude_from_sim no) (at 30.00 108.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f3e826cb-cf0a-4560-a10f-0804554d45d4")) (text "EN: 169k/36.1k (schema tipico TI). MODE libero = FCCM (R114 DNP): frequenza fissa, ripple basso vicino al GNSS. Il jack e' separato dal TPS2121 U108, niente corrente inversa nel buck." (exclude_from_sim no) (at 30.00 113.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ac611282-3b9a-48b5-a1e2-dd3c2f9a4892")) (text "Senza eFuse il buck vede direttamente il BUS_POWER: niente limite di corrente, UVLO/OVLO e blocco inverso sui 12 V (protezione a carico del modulo Power)." (exclude_from_sim no) (at 30.00 118.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "90b595dc-e515-4086-b2dd-9e4232a929d8")) (text "2) Jack DC 5 V (DC-005-5A-2.0) su 5V_JACK, TVS D101, nessun fusibile. TPS2121 U108: IN1 = 5V_BUCK (bus 12 V) con priorita, IN2 = jack. Uscita 5V_EXT -> IN1 di U103." (exclude_from_sim no) (at 30.00 118.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5614665e-0ac2-44ec-82f0-0f8ae85627ad")) (wire (pts (xy 38.10 127.00) (xy 40.64 127.00)) (stroke (width 0) (type default)) (uuid "85d02381-feaf-450e-87fb-a0bf2f1c80f6")) (label "5V_JACK" (at 40.64 127.00 0) (effec
  )) (text "MEMORIE: DDR4 x16 (1 chip, point-to-point, niente VTT), eMMC 8 bit su EMMC (VCCIO2 1.8 V), microSD su SDMMC0 (VCCIO3). Serie 4xx." (exclude_from_sim no) (at 20.00 15.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "16f983d4-68ef-4cb1-a87e-89799cafe10a")) (text "U401 Samsung K4AAG165WA-BCWE (LCSC C2920140, 16 Gbit = 2 GB, x16, DDR4-3200): VDD/VDDQ = VCC_DDR 1.2 V (BUCK3), VPP = VCC2V5_DDR (AP2112K-2.5). Collegata al canale A del PHY dell'RK3568." (exclude_from_sim no) (at 20.00 22.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "981e8333-0da4-4dd8-848a-9aca8f35d758")) (text "DQ/DM/DQS secondo il pinout Rockchip (DDR_DQx_A -> DDR4_DQL/DQU_A): l'ordine dei bit nel byte e' quello del template Rockchip, i CA non si possono scambiare (Hardware Design Guide 2.1.7)." (exclude_from_sim no) (at 20.00 27.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8aecf875-5edf-4b8d-ac5f-6e9c7e4432d6")) (wire (pts (xy 77.47 90.17) (xy 72.39 90.17)) (stroke (width 0) (type default)) (uuid "afaab9f1-2325-41ec-9f41-6e87a8ebc6ff")) (global_label "DDR_A0" (shape passive) (at 72.39 90.17 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "2ebd7ef0-38f1-40a5-98c3-ca16f2491400")) (wire (pts (xy 77.47 92.71) (xy 72.39 92.71)) (stroke (width 0) (type default)) (uuid "d6f051ce-32eb-4580-9dc7-d971807b1377")) (global_label "DDR_A10" (shape passive) (at 72.39 92.71 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "84f3950e-601e-41dc-ba74-597530247a85")) (wire (pts (xy 77.47 95.25) (xy 72.39 95.25)) (stroke (width 0) (type default)) (uuid "f9b10a64-26b5-4abf-ad6a-ae9758baafaf")) (global_label "DDR_A11" (shape passive) (at 72.39 95.25 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "89940334-c123-4581-b395-151b3447642d")) (wire (pts (xy 77.47 97.79) (xy 72.39 97.79)) (stroke (width 0) (type default)) (uuid "9cd5f5e3-abf1-4beb-b3
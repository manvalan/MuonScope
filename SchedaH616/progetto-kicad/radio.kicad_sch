	)) (text "RADIO: AMPAK AP6256 (Wi-Fi 5 + BT 5.0) su SDMMC2_M0 (SDIO, VCCIO6), HCI su UART8_M0 con RTS/CTS (VCCIO4), REG_ON e wake su GPIO. Serie 6xx. Net WL_*/BT_*/CLK32K globali." (exclude_from_sim no) (at 20.00 15.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "84d04627-831f-4d6d-bd45-4e522bc346d2")) (text "VDDIO = VCC_3V3 3.3 V (= VCCIO6/VCCIO4), SDIO 2.0 fino a 50 MHz. VBAT e VIN_LDO da VCC_3V3. LPO 32.768 kHz da CLK32K dell'RK809-5 (quarzo Y201)." (exclude_from_sim no) (at 20.00 20.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8901c9b2-eaa2-4074-abca-8c008c38ba40")) (wire (pts (xy 86.36 83.82) (xy 81.28 83.82)) (stroke (width 0) (type default)) (uuid "5f896f55-90b1-46b9-9187-aa6e4d6bfa54")) (global_label "GND_D" (shape passive) (at 81.28 83.82 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "f5cd8f12-3f32-419d-b42a-feffd7d0723f")) (wire (pts (xy 86.36 86.36) (xy 81.28 86.36)) (stroke (width 0) (type default)) (uuid "1279a7b9-9648-479b-9d08-ad25678fee7a")) (global_label "WL_ANT" (shape passive) (at 81.28 86.36 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "56f88ec5-d54b-402f-9b46-9af263fe053d")) (wire (pts (xy 86.36 88.90) (xy 81.28 88.90)) (stroke (width 0) (type default)) (uuid "ee435030-2d1b-4074-a034-d603d142768f")) (global_label "GND_D" (shape passive) (at 81.28 88.90 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "5655f66c-631c-4e79-b4c7-770e3b45ca31")) (no_connect (at 86.36 91.44) (uuid "105f68e3-0732-45a2-96e9-7e4e02578741")) (no_connect (at 86.36 93.98) (uuid "ac2730c3-2c04-477a-b2cb-c13f8274f45a")) (wire (pts (xy 86.36 96.52) (xy 81.28 96.52)) (stroke (width 0) (type default)) (uuid "3a800c53-4bd6-457f-8e8b-6dcc2bc1ba79")) (global_label "BT_WAKE" (shape passive) (at 81.28 96.52 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "808941f8-3505-4dcb-9298-3231e5e1b2
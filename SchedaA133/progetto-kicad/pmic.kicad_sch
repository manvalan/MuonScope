	)) (text "PMIC AXP717 secondo il reference Allwinner A100_A133_B3_AXP707_LPDDR3 (pag. 05, che usa l'AXP717). Ingresso 5V_SYS dal TPS2121. Niente batteria." (exclude_from_sim no) (at 25.00 25.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0b97fccb-8a6c-4ab9-9a09-e83c9a8005fe")) (text "Net rinominate come nel reference. Alias: VCC-PLL = AVCC/VCC-PLL/VDD18-DRAM; VCC-PC = VCC-PC/VCC-EFUSE/CPVIN/VCC-LVDS (1.8 V, VCCQ eMMC);" (exclude_from_sim no) (at 25.00 30.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0a471af8-f7a7-40df-87a1-4aa6997cdfe8")) (text "VCC-IO = VCC-IO/VCC-USB/VCC-PD/VCC-3V3 (3.3 V); VCC-CARD = VCC-CARD/VCC-NAND (microSD + VCC eMMC). LPDDR4: VDD2/VDDQ = VCC-DRAM 1.1 V, VDD1 = VDD18-LPDDR 1.8 V. Niente VPP (solo DDR4)." (exclude_from_sim no) (at 25.00 35.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "acc66a12-a039-4600-95b3-d27af6d7f041")) (wire (pts (xy 181.61 118.11) (xy 179.07 118.11)) (stroke (width 0) (type default)) (uuid "0ccd7729-e3e3-4aed-9775-b8dfab0da659")) (hierarchical_label "5V_SYS" (shape passive) (at 179.07 118.11 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "7f14e67f-51d5-406e-840a-c8c7603649e7")) (wire (pts (xy 181.61 120.65) (xy 179.07 120.65)) (stroke (width 0) (type default)) (uuid "cc4a6820-2df8-4691-9020-b1e6fe832c45")) (hierarchical_label "5V_SYS" (shape passive) (at 179.07 120.65 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "be5ec1cb-3a41-4f4e-80a3-76bb2db7799b")) (wire (pts (xy 181.61 123.19) (xy 179.07 123.19)) (stroke (width 0) (type default)) (uuid "0676a350-507b-49dc-966b-7a24173e1272")) (label "VMID" (at 179.07 123.19 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "ff2093a3-b353-41e9-acce-a565e72c8154")) (wire (pts (xy 181.61 125.73) (xy 179.07 125.73)) (stroke (width 0) (type default)) (uuid "18bccc2e-3de3-44ba-860e-506ec99b9337")) (label "VMID" (at 179.07 125.73 180) (effects (font (size 1.27 1.27)) (justif
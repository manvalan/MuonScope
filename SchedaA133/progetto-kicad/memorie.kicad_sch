	)) (text "MEMORIE: LPDDR4 2 GB x32, eMMC 256 GB su SMHC2 (PC), microSD su SMHC0 (PF). Serie componenti 4xx." (exclude_from_sim no) (at 20.00 15.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "082e52ac-d2f4-4512-8a85-4d7c4696725d")) (text "Le net DRAM_*, EMMC_*, SD_* sono etichette globali condivise con il foglio CPU (porte tolte dal blocco CPU)." (exclude_from_sim no) (at 20.00 20.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ceef155e-4121-4ad5-a4b6-20de74b1e7a4")) (text "U401 LPDDR4 MT53E512M32D1ZW-046 IT:B (2 GB, 1 die, 2 canali x16). Collegamento come nel reference Allwinner A100_A133 (pag. 08, colonna LPDDR4):" (exclude_from_sim no) (at 20.00 30.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "66410496-3872-4fe9-a3ee-164ca12071d5")) (text "CA0-5 <- SA5,SA0,SA2,SA1,SCS0,SCS1 del SoC; CS0/CS1 <- SA4/SA3; byte scambiati (canale A = DQ8-15 e DQ0-7, canale B = DQ16-23 e DQ24-31) come nel reference." (exclude_from_sim no) (at 20.00 35.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "386e34a2-666e-463d-a5ad-1a5c113376b2")) (wire (pts (xy 52.07 104.14) (xy 46.99 104.14)) (stroke (width 0) (type default)) (uuid "0eb248a9-33c2-418a-8074-8bc7298a6809")) (global_label "DRAM_A5" (shape passive) (at 46.99 104.14 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "7530e1d5-c837-4cf8-a7c0-ff8a6fa3494d")) (wire (pts (xy 52.07 106.68) (xy 46.99 106.68)) (stroke (width 0) (type default)) (uuid "45d63a01-75cf-49d2-b82d-eaf337a8aeff")) (global_label "DRAM_A0" (shape passive) (at 46.99 106.68 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "6e55d4a0-fbde-4782-853e-476e0224ce00")) (wire (pts (xy 52.07 109.22) (xy 46.99 109.22)) (stroke (width 0) (type default)) (uuid "b58787c3-a475-4c7f-8819-4dd4257d6f28")) (global_label "DRAM_A2" (shape passive) (at 46.99 109.22 180) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justif